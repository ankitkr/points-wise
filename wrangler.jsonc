{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "points-wise",
  "compatibility_date": "2026-05-13",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "D1",
      "database_name": "points-wise",
      "database_id": "cb0eb4ef-1263-4507-8d59-00b1bbc32e26",
      "migrations_dir": "drizzle"
    }
  ],
  // LedgerDO is defined and migrated in the separate points-wise-ledger Worker
  // (workers/ledger). The web Worker only REFERENCES it via script_name, so the
  // DO implementation stays out of the OpenNext bundle and no migration is
  // declared here. Deploy order: points-wise-ledger BEFORE points-wise.
  "durable_objects": {
    "bindings": [{ "name": "LEDGER_DO", "class_name": "LedgerDO", "script_name": "points-wise-ledger" }]
  },
  "observability": {
    "enabled": true
  }
}
