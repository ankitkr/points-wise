{
  "name": "points-wise",
  "version": "0.0.0",
  "description": "PointsWise — credit-card rewards and cashback tracker",
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "packageManager": "pnpm@10.33.4",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev --webpack",
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build --webpack",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "typecheck": "tsc --noEmit",
    "generate:types": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply points-wise --local",
    "db:migrate:remote": "wrangler d1 migrations apply points-wise --remote",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.19.7",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-slot": "^1.2.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cross-env": "^7.0.3",
    "drizzle-orm": "^0.44.0",
    "lucide-react": "^0.545.0",
    "next": "16.2.5",
    "next-auth": "5.0.0-beta.31",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "tailwind-merge": "^3.6.0",
    "ulid": "^3.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "22.19.9",
    "@types/react": "19.2.9",
    "@types/react-dom": "19.2.3",
    "@cloudflare/workers-types": "^4.20250110.0",
    "autoprefixer": "^10.5.0",
    "drizzle-kit": "^0.31.0",
    "eslint": "^9.16.0",
    "eslint-config-next": "16.2.5",
    "postcss": "^8.5.10",
    "tailwindcss": "^3.4.19",
    "typescript": "5.7.3",
    "wrangler": "~4.88.0"
  },
  "engines": {
    "node": "^18.20.2 || >=20.9.0",
    "pnpm": "^9 || ^10"
  }
}
